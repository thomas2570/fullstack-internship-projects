PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eduflow_lms?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Redis & Bull Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Video Delivery & AWS CloudFront
USE_LOCAL_CDN_FALLBACK=true
AWS_CLOUDFRONT_DOMAIN=https://d111111abcdef8.cloudfront.net
AWS_S3_BUCKET=eduflow-streaming-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key

# Business Logic
PLATFORM_FEE_PERCENTAGE=30
INSTRUCTOR_SHARE_PERCENTAGE=70

CLIENT_URL=http://localhost:5173

