# ==========================================
# Root .gitignore for Fullstack Internship Projects Monorepo
# ==========================================

# Dependencies across all project subdirectories
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
dist/
**/dist/
build/
**/build/
.next/
**/out/

# Environment and Secrets (CRITICAL: Never commit secrets)
.env
*.env
.env.*
!.env.example
!**/.env.example

# Runtime & System Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
**/coverage/
*.lcov

# Media & Generated test uploads (directories preserved via .gitkeep)
**/uploads/certificates/*.pdf
**/uploads/videos/*.mp4
**/uploads/videos/*.mov
**/uploads/videos/raw-*
**/uploads/thumbnails/*.jpg
**/uploads/thumbnails/*.png

# Python & Django (FS-04)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db
backend_venv/
**/backend_venv/
.venv/
**/.venv/
env/
venv/
staticfiles/
**/staticfiles/
celerybeat-schedule*
celerybeat.pid
