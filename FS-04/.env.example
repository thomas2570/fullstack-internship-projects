# Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-saas-pm-secret-key-prod-grade-2026
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' for zero-setup local runs or 'postgres' for Docker/Prod
DB_ENGINE=sqlite
DB_NAME=saas_pm_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Stripe Test Billing Configuration
STRIPE_PUBLIC_KEY=pk_test_sample_key_pm_saas
STRIPE_SECRET_KEY=sk_test_sample_key_pm_saas
STRIPE_WEBHOOK_SECRET=whsec_sample_secret_pm_saas

# Frontend URL
FRONTEND_URL=http://localhost:5173
